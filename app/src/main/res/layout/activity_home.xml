<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== 主页（CoordinatorLayout 以支持 FAB 锚定） ===== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".HomeActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ===== 顶部栏：app 名称 + 设置（仅这两个，无重复） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#1565C0"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/homeSettingsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textSize="13sp"
                    android:backgroundTint="#1976D2"
                    android:textColor="#FFFFFF"
                    android:minHeight="40dp" />
            </LinearLayout>

            <!-- ===== 状态提示 ===== -->
            <TextView
                android:id="@+id/homeStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textSize="12sp"
                android:textColor="#666666"
                android:background="#F5F5F5" />

            <!-- ===== 模型列表（滚动） ===== -->
            <ScrollView
                android:id="@+id/homeScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/homeModelListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/homeModelListText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_status_empty"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:gravity="center"
                        android:padding="40dp" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- ===== 右下角导入 FAB（加号） ===== -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/homeImportFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="@string/model_import"
            app:tint="#FFFFFF"
            app:backgroundTint="#1565C0" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ===== 外观设置抽屉（右侧滑出）：黑夜模式 ===== -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textStyle="bold"
                android:textSize="18sp" />

            <Button
                android:id="@+id/homeSettingsCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_close"
                android:minHeight="40dp" />
        </LinearLayout>

        <!-- 黑夜模式开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dark_mode"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/homeDarkModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dark_mode_hint"
            android:textSize="11sp"
            android:textColor="#888888" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
